MainWindow
  id: idleAssignObjectWindow
  !text: tr('Assign Object (IDLE)')
  size: 380 620
  @onEscape: self:destroy()

  Panel
    id: previewContainer
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 38

    UIItem
      id: previewItem
      size: 34 34
      anchors.top: parent.top
      anchors.left: parent.left
      virtual: true

    Label
      id: previewLabel
      font: verdana-11px-rounded
      color: #ffffff
      anchors.top: parent.top
      anchors.left: previewItem.right
      anchors.right: parent.right
      margin-left: 10
      margin-top: 2
      text-auto-resize: true
      !text: tr('No object selected')

  HorizontalSeparator
    id: sep1
    anchors.top: previewContainer.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6

  Panel
    id: catPanel
    anchors.top: sep1.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    margin-top: 6
    layout:
      type: horizontalBox
      spacing: 4

  UIScrollArea
    id: itemList
    anchors.top: catPanel.bottom
    anchors.left: parent.left
    anchors.right: itemScrollBar.left
    anchors.bottom: conditionBox.top
    margin-top: 6
    margin-bottom: 6
    margin-right: 4
    vertical-scrollbar: itemScrollBar
    layout:
      type: verticalBox

  VerticalScrollBar
    id: itemScrollBar
    anchors.top: catPanel.bottom
    anchors.bottom: conditionBox.top
    anchors.right: parent.right
    margin-top: 6
    margin-bottom: 6
    step: 38
    pixels-scroll: true

  Panel
    id: conditionBox
    height: 60
    image-source: /images/ui/containerslot
    image-border: 3
    padding: 6
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: sep2.top
    margin-bottom: 8

    Label
      id: conditionTitle
      font: verdana-11px-rounded
      color: #00ff88
      anchors.top: parent.top
      anchors.left: parent.left
      !text: tr('Trigger Condition (IDLE Hunt):')

    Panel
      id: triggerRow
      anchors.top: conditionTitle.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 24
      margin-top: 6

      Label
        id: triggerWhenLabel
        font: verdana-11px-rounded
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: parent.left
        text-auto-resize: true
        !text: tr('Use item when:')

      ComboBox
        id: resourceCombo
        width: 65
        height: 20
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: triggerWhenLabel.right
        margin-left: 6

      Label
        id: opLabel
        font: verdana-11px-rounded
        color: #ffd700
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: resourceCombo.right
        margin-left: 8
        text-auto-resize: true
        !text: tr('<=')

      TextEdit
        id: percentInput
        width: 45
        height: 20
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: opLabel.right
        margin-left: 8
        text: 60

      Label
        id: pctSign
        font: verdana-11px-rounded
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: percentInput.right
        margin-left: 4
        text-auto-resize: true
        text: %

  HorizontalSeparator
    id: sep2
    anchors.bottom: footerPanel.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-bottom: 6

  Panel
    id: footerPanel
    height: 24
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    anchors.right: parent.right

    Button
      id: buttonClose
      !text: tr('Cancel')
      font: cipsoftFont
      width: 60
      height: 22
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter

    Button
      id: buttonApply
      !text: tr('Apply')
      font: cipsoftFont
      width: 60
      height: 22
      anchors.right: buttonClose.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4

    Button
      id: buttonOk
      !text: tr('Ok')
      font: cipsoftFont
      width: 50
      height: 22
      anchors.right: buttonApply.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4