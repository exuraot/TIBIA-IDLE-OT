ElementBadge < Panel
  size: 92 32
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 2

  Label
    id: elementLabel
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    text-auto-resize: true

  Label
    id: valueLabel
    font: verdana-11px-rounded
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    text-auto-resize: true

DropRowItem < Panel
  height: 38
  margin-top: 4
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 4

  UIItem
    id: itemWidget
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true

  Label
    id: itemNameLabel
    font: verdana-11px-rounded
    color: #ffd700
    anchors.top: parent.top
    anchors.left: itemWidget.right
    margin-left: 8
    text-auto-resize: true

  Label
    id: itemInfoLabel
    font: verdana-11px-rounded
    color: #a0a0a0
    anchors.bottom: parent.bottom
    anchors.left: itemWidget.right
    margin-left: 8
    text-auto-resize: true

  Button
    id: lockButton
    font: verdana-11px-rounded
    size: 150 24
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter

HuntCard < Panel
  height: 74
  margin-top: 4
  margin-bottom: 2
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 6

  Panel
    id: monsterFrame
    size: 48 48
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    image-source: /images/ui/containerslot
    image-border: 2

    UICreature
      id: monsterCreature
      size: 44 44
      anchors.centerIn: parent
      phantom: true

  Button
    id: configButton
    !text: tr('Configurar')
    font: verdana-11px-rounded
    color: #00ff88
    width: 90
    height: 26
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter

  Label
    id: huntTitle
    font: verdana-11px-rounded
    color: #ffd700
    anchors.top: parent.top
    anchors.left: monsterFrame.right
    margin-left: 8
    text-auto-resize: true

  Label
    id: focusTag
    font: verdana-11px-rounded
    anchors.top: parent.top
    anchors.left: huntTitle.right
    margin-left: 8
    text-auto-resize: true

  Label
    id: huntDesc
    font: verdana-11px-rounded
    color: #c0c0c0
    anchors.top: huntTitle.bottom
    anchors.left: monsterFrame.right
    anchors.right: configButton.left
    margin-top: 3
    margin-left: 8
    margin-right: 8
    height: 26
    text-wrap: true

  Label
    id: huntCost
    font: verdana-11px-rounded
    color: #888888
    anchors.bottom: parent.bottom
    anchors.left: monsterFrame.right
    margin-left: 8
    text-auto-resize: true

  Label
    id: recordLabel
    font: verdana-11px-rounded
    color: #00ddff
    anchors.bottom: parent.bottom
    anchors.left: huntCost.right
    margin-left: 12
    text-auto-resize: true

TipBox < Panel
  height: 36
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 4

  UIWidget
    id: tipIcon
    size: 16 16
    image-source: /images/topbuttons/questlog
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  Label
    id: tipTitle
    !text: tr('[DICA]')
    font: verdana-11px-rounded
    color: #ffd700
    anchors.left: tipIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    text-auto-resize: true

  Label
    id: tipText
    font: verdana-11px-rounded
    color: #99ddff
    anchors.left: tipTitle.right
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 6
    text-wrap: true

MainWindow
  id: idleHuntWindow
  !text: tr('IDLE HUNT - SISTEMA DE CACADAS')
  size: 720 620
  @onEscape: self:hide()

  Panel
    id: dashboardView
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    visible: true

    Panel
      id: staminaPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 44
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 6

      Label
        id: staminaLabel
        !text: tr('Stamina IDLE: 24h 00m')
        font: verdana-11px-rounded
        color: #00ffcc
        anchors.top: parent.top
        anchors.left: parent.left
        text-auto-resize: true

      Label
        id: staminaInfo
        !text: tr('(Consumo 3x mais lento: 1h Stamina = 3h reais)')
        font: verdana-11px-rounded
        color: #a0a0a0
        anchors.top: staminaLabel.top
        anchors.right: parent.right
        text-auto-resize: true

      ProgressBar
        id: staminaBar
        anchors.top: staminaLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        height: 10
        background-color: #00cc88

    Panel
      id: dashboardBottomBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 28

      Button
        id: quickSellButton
        !text: tr('Quick Sell')
        font: verdana-11px-rounded
        width: 140
        height: 26
        color: #00ff88
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        tooltip: tr('Vender imediatamente itens da backpack marcados como [UNLOCKED]')

      Button
        id: teleportTempleButton
        !text: tr('Templo')
        font: verdana-11px-rounded
        width: 80
        height: 26
        anchors.left: quickSellButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        tooltip: tr('Teleportar para o Templo')

      Button
        id: teleportHouseButton
        !text: tr('Casa')
        font: verdana-11px-rounded
        width: 80
        height: 26
        anchors.left: teleportTempleButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        tooltip: tr('Teleportar para a sua casa')

      Button
        id: closeButton
        !text: tr('Fechar')
        font: verdana-11px-rounded
        width: 80
        height: 26
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        @onClick: idleHuntController:toggle()

    Panel
      id: idleModeCard
      anchors.top: staminaPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: dashboardBottomBar.top
      margin-top: 8
      margin-bottom: 8
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 12
      visible: true

      Label
        id: idleTitle
        !text: tr('PRONTO PARA INICIAR UMA CACADA IDLE')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 35
        text-auto-resize: true

      Label
        id: idleDesc
        !text: tr('Escolha uma das 21 hunts disponiveis divididas em Facil, Medio e Dificil.\nConfigure sua intensidade de Pull, analise os elementos das criaturas e avance continuamente!')
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.top: idleTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 14
        margin-left: 20
        margin-right: 20
        height: 34
        text-align: center
        text-wrap: true

      Button
        id: openCatalogButton
        !text: tr('ORGANIZAR CACADA')
        font: verdana-11px-rounded
        color: #00ff88
        size: 240 38
        anchors.centerIn: parent
        tooltip: tr('Abrir o catalogo de hunts para escolher onde cacar')

      TipBox
        id: dashboardTipBox
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 6

    Panel
      id: activeHuntCard
      anchors.top: staminaPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: dashboardBottomBar.top
      margin-top: 8
      margin-bottom: 8
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 12
      visible: false

      Panel
        id: activeCreatureFrame
        size: 64 64
        image-source: /images/ui/containerslot
        image-border: 2
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 4

        UICreature
          id: activeCreature
          size: 58 58
          anchors.centerIn: parent
          phantom: true

      Label
        id: activeTitle
        !text: tr('Cacando: ...')
        font: verdana-11px-rounded
        color: #00ff88
        anchors.top: parent.top
        anchors.left: activeCreatureFrame.right
        margin-top: 6
        margin-left: 12
        text-auto-resize: true

      Label
        id: activePullLabel
        !text: tr('Intensidade: [Ousado]')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: activeTitle.bottom
        anchors.left: activeCreatureFrame.right
        margin-top: 6
        margin-left: 12
        text-auto-resize: true

      Panel
        id: activeStatsBox
        anchors.top: activeCreatureFrame.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: activeTipBox.top
        margin-top: 10
        margin-bottom: 8
        image-source: /images/ui/containerslot
        image-border: 2
        padding: 8
        layout:
          type: verticalBox
          spacing: 8

        Label
          id: statXp
          !text: tr('Experiencia Ganha: +0 XP')
          font: verdana-11px-rounded
          color: #00ff88
          text-auto-resize: true

        Label
          id: statGold
          !text: tr('Ouro / Loot Coletado: 0 gp')
          font: verdana-11px-rounded
          color: #ffd700
          text-auto-resize: true

        Label
          id: statSupplies
          !text: tr('Suprimentos Gastos: 0 gp')
          font: verdana-11px-rounded
          color: #ff9955
          text-auto-resize: true

        Label
          id: statRates
          !text: tr('Taxa Atual: 0 XP/h | 0 GP/h')
          font: verdana-11px-rounded
          color: #00ddff
          text-auto-resize: true

        Label
          id: statTime
          !text: tr('Tempo de Cacada: 00m 00s')
          font: verdana-11px-rounded
          color: #e0e0e0
          text-auto-resize: true

        Label
          id: statAutosell
          !text: tr('Proxima Auto-Venda em: 10m 00s')
          font: verdana-11px-rounded
          color: #a0a0a0
          text-auto-resize: true

      TipBox
        id: activeTipBox
        anchors.bottom: stopHuntButton.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 8

      Button
        id: stopHuntButton
        !text: tr('ENCERRAR CACADA')
        font: verdana-11px-rounded
        color: #ff5555
        size: 220 30
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-bottom: 6

  Panel
    id: catalogView
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    visible: false

    Panel
      id: catalogTopBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      Button
        id: backToDashboardBtn
        !text: tr('< Voltar ao Painel')
        font: verdana-11px-rounded
        width: 140
        height: 26
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      Label
        id: searchLabel
        !text: tr('Buscar:')
        font: verdana-11px-rounded
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: searchEdit.left
        margin-right: 6
        text-auto-resize: true

      TextEdit
        id: searchEdit
        width: 220
        height: 24
        font: verdana-11px-rounded
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter

    Panel
      id: catalogFilterPanel
      anchors.top: catalogTopBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 26
      layout:
        type: horizontalBox
        spacing: 6

    TipBox
      id: catalogTipBox
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 4

    VerticalScrollBar
      id: huntListScrollBar
      anchors.top: catalogFilterPanel.bottom
      anchors.bottom: catalogTipBox.top
      anchors.right: parent.right
      margin-top: 6
      margin-bottom: 6
      step: 40
      pixels-scroll: true

    UIScrollArea
      id: huntList
      anchors.top: catalogFilterPanel.bottom
      anchors.left: parent.left
      anchors.right: huntListScrollBar.left
      anchors.bottom: catalogTipBox.top
      margin-top: 6
      margin-right: 4
      margin-bottom: 6
      vertical-scrollbar: huntListScrollBar
      layout:
        type: verticalBox
        spacing: 4

  Panel
    id: detailsView
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    visible: false

    Panel
      id: detailsTopBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      Button
        id: backToCatalogBtn
        !text: tr('< Voltar ao Catalogo')
        font: verdana-11px-rounded
        width: 150
        height: 26
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      Label
        id: detailsTitle
        !text: tr('Configurar Cacada')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: backToCatalogBtn.right
        margin-left: 12
        text-auto-resize: true

    Panel
      id: detailCreatureHeader
      anchors.top: detailsTopBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 64
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 4

      Panel
        id: detailCreatureFrame
        size: 54 54
        image-source: /images/ui/containerslot
        image-border: 2
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2

        UICreature
          id: detailCreature
          size: 48 48
          anchors.centerIn: parent
          phantom: true

      Label
        id: detailHuntName
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: detailCreatureFrame.right
        margin-top: 2
        margin-left: 8
        text-auto-resize: true

      Label
        id: detailHuntDesc
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.top: detailHuntName.bottom
        anchors.left: detailCreatureFrame.right
        anchors.right: parent.right
        margin-top: 2
        margin-left: 8
        margin-right: 8
        height: 26
        text-wrap: true

      Label
        id: detailHuntInfo
        font: verdana-11px-rounded
        color: #e0bb66
        anchors.bottom: parent.bottom
        anchors.left: detailCreatureFrame.right
        margin-left: 8
        margin-bottom: 2
        text-auto-resize: true

      Label
        id: detailRecordLabel
        font: verdana-11px-rounded
        color: #00ddff
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-right: 8
        margin-bottom: 2
        text-auto-resize: true

    Panel
      id: pullsPanel
      anchors.top: detailCreatureHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 52
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: pullsTitle
        !text: tr('1. Intensidade do Pull (Criaturas por Onda):')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      Button
        id: pullCautiousBtn
        !text: tr('Cauteloso (1 Mob)')
        font: verdana-11px-rounded
        width: 180
        height: 22
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 4
        margin-bottom: 2

      Button
        id: pullBoldBtn
        !text: tr('Ousado (2-3 Mobs)')
        font: verdana-11px-rounded
        width: 180
        height: 22
        anchors.bottom: parent.bottom
        anchors.left: pullCautiousBtn.right
        margin-left: 8
        margin-bottom: 2

      Button
        id: pullAggressiveBtn
        !text: tr('Agressivo (4-6 Mobs)')
        font: verdana-11px-rounded
        width: 180
        height: 22
        anchors.bottom: parent.bottom
        anchors.left: pullBoldBtn.right
        margin-left: 8
        margin-bottom: 2

    Panel
      id: elementsPanel
      anchors.top: pullsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 58
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: elementsTitle
        !text: tr('2. Fraquezas e Resistencias Elementais:')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      Panel
        id: elementsRow
        anchors.top: elementsTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 36
        layout:
          type: horizontalBox
          spacing: 6

    TipBox
      id: detailsTipBox
      anchors.bottom: reqPanel.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 6

    Panel
      id: dropsBoxPanel
      anchors.top: elementsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: detailsTipBox.top
      margin-top: 6
      margin-bottom: 6
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: dropsTitle
        !text: tr('3. Drops da Hunt ([LOCKED] = BP | [UNLOCKED] = Venda no Banco):')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      VerticalScrollBar
        id: detailDropsScrollBar
        anchors.top: dropsTitle.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 4
        step: 40
        pixels-scroll: true

      UIScrollArea
        id: detailDropsList
        anchors.top: dropsTitle.bottom
        anchors.left: parent.left
        anchors.right: detailDropsScrollBar.left
        anchors.bottom: parent.bottom
        margin-top: 4
        margin-right: 4
        vertical-scrollbar: detailDropsScrollBar
        layout:
          type: verticalBox

    Panel
      id: reqPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: startHuntButton.top
      margin-bottom: 8
      height: 48
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: reqSummaryLabel
        !text: tr('Requisitos de Sobrevivencia: Verificando...')
        font: verdana-11px-rounded
        color: #00ff88
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      Label
        id: reqDetailsLabel
        !text: tr('Level: OK | Ataque: OK | Defesa: OK | Banco: OK | Pocoes: Health/Mana')
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 4
        margin-bottom: 2
        text-auto-resize: true

    Button
      id: startHuntButton
      !text: tr('INICIAR CACADA IDLE')
      font: verdana-11px-rounded
      color: #00ff88
      size: 240 30
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 4