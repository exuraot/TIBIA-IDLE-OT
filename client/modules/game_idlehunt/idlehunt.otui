ElementBadge < Panel
  size: 74 30
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 2

  Label
    id: elementLabel
    font: verdana-11px-rounded
    color: #e0e0e0
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 1
    text-auto-resize: true

  Label
    id: valueLabel
    font: verdana-11px-rounded
    color: #00ff88
    anchors.bottom: parent.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 1
    text-auto-resize: true

HuntingDropRow < Panel
  height: 40
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 2
  margin-bottom: 3

  UIItem
    id: itemWidget
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4
    virtual: true

  Label
    id: itemNameLabel
    font: verdana-11px-rounded
    color: #ffffff
    anchors.top: parent.top
    anchors.left: itemWidget.right
    anchors.right: autoLootButton.left
    margin-left: 8
    margin-top: 2
    margin-right: 6
    text-auto-resize: true

  Label
    id: itemInfoLabel
    font: verdana-11px-rounded
    color: #ffd700
    anchors.bottom: parent.bottom
    anchors.left: itemWidget.right
    anchors.right: autoLootButton.left
    margin-left: 8
    margin-bottom: 2
    margin-right: 6
    text-auto-resize: true

  Button
    id: autoLootButton
    size: 56 24
    anchors.right: padlockButton.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    !text: tr('Loot: ON')
    font: verdana-11px-rounded
    color: #00ff88
    tooltip: tr('Auto Loot: Ativado (Clique para ignorar este item nos monstros)')

  Button
    id: padlockButton
    size: 26 24
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    icon-source: /images/game/actionbar/locked
    icon-offset: 0 0
    $pressed:
      icon-offset: 1 1

DropRowCheckItem < Panel
  height: 40
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 2
  margin-bottom: 3

  UIItem
    id: itemWidget
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    virtual: true

  Label
    id: itemNameLabel
    font: verdana-11px-rounded
    color: #ffffff
    anchors.top: parent.top
    anchors.left: itemWidget.right
    anchors.right: padlockButton.left
    margin-left: 8
    margin-top: 2
    margin-right: 4
    text-auto-resize: true

  Label
    id: itemInfoLabel
    font: verdana-11px-rounded
    color: #ffd700
    anchors.bottom: parent.bottom
    anchors.left: itemWidget.right
    anchors.right: padlockButton.left
    margin-left: 8
    margin-bottom: 2
    margin-right: 4
    text-auto-resize: true

  Button
    id: padlockButton
    size: 26 24
    anchors.right: keepCheckBox.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 8
    icon-source: /images/game/actionbar/locked
    icon-offset: 0 0
    $pressed:
      icon-offset: 1 1

  CheckBox
    id: keepCheckBox
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 64

  CheckBox
    id: sellCheckBox
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 18

TipBox < Panel
  height: 42
  image-source: /images/ui/containerslot
  image-border: 2
  padding: 4

  UIWidget
    id: tipIcon
    size: 16 16
    image-source: /images/topbuttons/questlog
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 4

  Label
    id: tipTitle
    !text: tr('[DICA]')
    font: verdana-11px-rounded
    color: #ffd700
    anchors.left: tipIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    text-auto-resize: true

  Label
    id: tipText
    font: verdana-11px-rounded
    color: #99ddff
    anchors.left: tipTitle.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 6
    margin-right: 6
    margin-top: 3
    margin-bottom: 3
    text-wrap: true

MainWindow
  id: idleHuntWindow
  !text: tr('IDLE HUNT - SISTEMA DE CACADAS')
  size: 720 620
  padding-top: 38
  padding-left: 14
  padding-right: 14
  padding-bottom: 14
  @onEscape: idleHuntController:toggle()

  Panel
    id: dashboardView
    anchors.fill: parent
    visible: true

    Panel
      id: staminaPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 38
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: staminaLabel
        !text: tr('Stamina IDLE: 24h 00m')
        font: verdana-11px-rounded
        color: #00ff88
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        margin-top: 2
        text-auto-resize: true

      Label
        id: staminaDesc
        !text: tr('(Consumo 3x mais lento: 1h Stamina = 3h reais)')
        font: verdana-11px-rounded
        color: #888888
        anchors.top: parent.top
        anchors.right: parent.right
        margin-right: 4
        margin-top: 2
        text-auto-resize: true

      ProgressBar
        id: staminaBar
        height: 10
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-left: 4
        margin-right: 4
        margin-bottom: 2
        background-color: #00cc66

    Panel
      id: idleModeCard
      anchors.top: staminaPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: dashboardBottomBar.top
      margin-top: 8
      margin-bottom: 8
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 12
      visible: true

      Label
        id: idleTitle
        !text: tr('PRONTO PARA INICIAR UMA CACADA IDLE')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 35
        text-auto-resize: true

      Label
        id: idleDesc
        !text: tr('Escolha uma das 21 hunts disponiveis divididas em Facil, Medio e Dificil.\nConfigure seus suprimentos, analise as fraquezas das criaturas e avance continuamente!')
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.top: idleTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 14
        margin-left: 20
        margin-right: 20
        height: 54
        text-align: center
        text-wrap: true

      Button
        id: openCatalogButton
        !text: tr('ORGANIZAR CACADA')
        font: verdana-11px-rounded
        color: #00ff88
        size: 240 38
        anchors.centerIn: parent

      TipBox
        id: dashboardTipBox
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 8
        margin-left: 10
        margin-right: 10
        height: 44

    Panel
      id: huntingCard
      anchors.top: staminaPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: dashboardBottomBar.top
      margin-top: 8
      margin-bottom: 8
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 10
      visible: false

      Panel
        id: huntingHeader
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 60
        image-source: /images/ui/containerslot
        image-border: 2
        padding: 4

        Panel
          id: activeMonsterFrame
          size: 52 52
          image-source: /images/ui/containerslot
          image-border: 2
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 2

          UICreature
            id: activeMonsterCreature
            size: 46 46
            anchors.centerIn: parent
            phantom: true

        Label
          id: activeHuntName
          font: verdana-11px-rounded
          color: #ffd700
          anchors.top: parent.top
          anchors.left: activeMonsterFrame.right
          margin-left: 8
          margin-top: 2
          text-auto-resize: true

        Label
          id: huntStatusBadge
          !text: tr('[CACANDO AO VIVO]')
          font: verdana-11px-rounded
          color: #00ff88
          anchors.top: parent.top
          anchors.left: activeHuntName.right
          margin-left: 8
          margin-top: 2
          text-auto-resize: true

        Label
          id: hpLabel
          !text: tr('HP do Jogador: 100%%')
          font: verdana-11px-rounded
          color: #ff5555
          anchors.bottom: parent.bottom
          anchors.left: activeMonsterFrame.right
          margin-left: 8
          margin-bottom: 4
          text-auto-resize: true

        Label
          id: durationLabel
          !text: tr('Tempo de Hunt: 00:00')
          font: verdana-11px-rounded
          color: #ffffff
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          margin-right: 8
          margin-bottom: 4
          text-auto-resize: true

      Panel
        id: metricsGrid
        anchors.top: huntingHeader.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        height: 64
        image-source: /images/ui/containerslot
        image-border: 2
        padding: 6

        Label
          id: xpSessionLabel
          !text: tr('EXP Sessao: +0')
          font: verdana-11px-rounded
          color: #00ff88
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 8
          margin-top: 4
          text-auto-resize: true

        Label
          id: xpRateLabel
          !text: tr('Taxa EXP/h: 0 XP/h')
          font: verdana-11px-rounded
          color: #00ddff
          anchors.top: parent.top
          anchors.right: parent.right
          margin-right: 8
          margin-top: 4
          text-auto-resize: true

        Label
          id: suppliesSpentLabel
          !text: tr('Suprimentos Gastos: 0 gp')
          font: verdana-11px-rounded
          color: #ffaa00
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-left: 8
          margin-bottom: 4
          text-auto-resize: true

        Label
          id: goldEarnedLabel
          !text: tr('Lucro Estimado: 0 gp')
          font: verdana-11px-rounded
          color: #ffd700
          anchors.bottom: parent.bottom
          anchors.right: parent.right
          margin-right: 8
          margin-bottom: 4
          text-auto-resize: true

      Panel
        id: autoSellPanel
        anchors.top: metricsGrid.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        height: 28
        image-source: /images/ui/containerslot
        image-border: 2
        padding: 4
        tooltip: tr('A cada 10 minutos todos os itens que nao estiverem com o cadeado fechado serao vendidos e o dinheiro depositado diretamente no seu banco.')

        Label
          id: autoSellTitleLabel
          !text: tr('AUTO SELL:')
          font: verdana-11px-rounded
          color: #ffd700
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 6
          text-auto-resize: true

        Label
          id: autoSellTimerLabel
          !text: tr('10:00')
          font: verdana-11px-rounded
          color: #00ff88
          anchors.left: autoSellTitleLabel.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 6
          text-auto-resize: true

        Label
          id: autoSellDescLabel
          !text: tr('(Venda automatica a cada 10m - Trave os itens no cadeado para nao vender)')
          font: verdana-11px-rounded
          color: #888888
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 6
          text-auto-resize: true

      Panel
        id: droppedLootCard
        anchors.top: autoSellPanel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: emergencyStopButton.top
        margin-top: 6
        margin-bottom: 6
        image-source: /images/ui/containerslot
        image-border: 2
        padding: 4

        Label
          id: lootSectionTitle
          !text: tr('Drops da Sessao & Controle de Venda (Cadeado: Fechado = Guardar | Aberto = Vender):')
          font: verdana-11px-rounded
          color: #ffd700
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 4
          margin-top: 2
          text-auto-resize: true

        ScrollablePanel
          id: huntingLootList
          anchors.top: lootSectionTitle.bottom
          anchors.left: parent.left
          anchors.right: huntingLootScrollBar.left
          anchors.bottom: parent.bottom
          margin-top: 4
          margin-right: 4
          vertical-scrollbar: huntingLootScrollBar
          layout:
            type: verticalBox
            fit-children: false

        VerticalScrollBar
          id: huntingLootScrollBar
          anchors.top: lootSectionTitle.bottom
          anchors.right: parent.right
          anchors.bottom: parent.bottom
          margin-top: 4
          step: 24
          pixels-scroll: true

      Button
        id: emergencyStopButton
        !text: tr('ENCERRAR CACADA E VOLTAR AO TEMPLO')
        font: verdana-11px-rounded
        color: #ff4444
        size: 320 32
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-bottom: 8

    Panel
      id: dashboardBottomBar
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      Button
        id: quickSellButton
        !text: tr('Quick Sell')
        font: verdana-11px-rounded
        color: #00ff88
        width: 130
        height: 26
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      Button
        id: teleportTempleButton
        !text: tr('Templo')
        font: verdana-11px-rounded
        width: 90
        height: 26
        anchors.left: quickSellButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6

      Button
        id: teleportHouseButton
        !text: tr('Casa')
        font: verdana-11px-rounded
        width: 90
        height: 26
        anchors.left: teleportTempleButton.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6

      Button
        id: closeDashboardButton
        !text: tr('Fechar')
        font: verdana-11px-rounded
        width: 90
        height: 26
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        @onClick: idleHuntController:toggle()

  Panel
    id: catalogView
    anchors.fill: parent
    visible: false

    Panel
      id: catalogTopBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      Button
        id: backToDashboardBtn
        !text: tr('< Voltar ao Painel')
        font: verdana-11px-rounded
        width: 150
        height: 26
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      TextEdit
        id: huntSearchInput
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        width: 220
        height: 24

      Label
        id: searchLabel
        !text: tr('Buscar:')
        font: verdana-11px-rounded
        color: #ffffff
        anchors.right: huntSearchInput.left
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 6
        text-auto-resize: true

    TipBox
      id: catalogTipBox
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 4
      height: 40

    VerticalScrollBar
      id: huntListScrollBar
      anchors.top: catalogTopBar.bottom
      anchors.bottom: catalogTipBox.top
      anchors.right: parent.right
      margin-top: 6
      margin-bottom: 6
      step: 40
      pixels-scroll: true

    UIScrollArea
      id: huntList
      anchors.top: catalogTopBar.bottom
      anchors.left: parent.left
      anchors.right: huntListScrollBar.left
      anchors.bottom: catalogTipBox.top
      margin-top: 6
      margin-right: 4
      margin-bottom: 6
      vertical-scrollbar: huntListScrollBar
      layout:
        type: verticalBox
        spacing: 4

  Panel
    id: detailsView
    anchors.fill: parent
    visible: false

    Panel
      id: detailsTopBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      Button
        id: backToCatalogBtn
        !text: tr('< Voltar ao Catalogo')
        font: verdana-11px-rounded
        width: 150
        height: 26
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter

      Label
        id: detailsTitle
        !text: tr('Configurar Cacada')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: backToCatalogBtn.right
        margin-left: 12
        text-auto-resize: true

      Label
        id: detailRecordLabel
        font: verdana-11px-rounded
        color: #00ddff
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: parent.right
        margin-right: 6
        text-auto-resize: true

    Panel
      id: detailCreatureHeader
      anchors.top: detailsTopBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 52
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 4

      Panel
        id: detailCreatureFrame
        size: 44 44
        image-source: /images/ui/containerslot
        image-border: 2
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2

        UICreature
          id: detailCreature
          size: 40 40
          anchors.centerIn: parent
          phantom: true

      Label
        id: detailHuntName
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: detailCreatureFrame.right
        margin-top: 2
        margin-left: 8
        text-auto-resize: true

      Label
        id: detailFocusTag
        font: verdana-11px-rounded
        color: #00ff88
        anchors.top: detailHuntName.top
        anchors.left: detailHuntName.right
        margin-left: 8
        text-auto-resize: true

      Label
        id: detailHuntDesc
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.bottom: parent.bottom
        anchors.left: detailCreatureFrame.right
        anchors.right: parent.right
        margin-left: 8
        margin-bottom: 2
        margin-right: 8
        height: 18
        text-wrap: true

    Panel
      id: leftConfigPanel
      anchors.top: detailCreatureHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.horizontalCenter
      anchors.bottom: detailsTipBox.top
      margin-top: 6
      margin-right: 4
      margin-bottom: 6
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 6

      Label
        id: diffTitle
        !text: tr('1. Dificuldade (Tamanho do Pull):')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 2
        text-auto-resize: true

      Panel
        id: diffButtonsRow
        anchors.top: diffTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 26

        Button
          id: diffEasyBtn
          !text: tr('Facil')
          font: verdana-11px-rounded
          color: #00ff88
          width: 104
          height: 24
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter

        Button
          id: diffMediumBtn
          !text: tr('Medio')
          font: verdana-11px-rounded
          color: #ffd700
          width: 104
          height: 24
          anchors.horizontalCenter: parent.horizontalCenter
          anchors.verticalCenter: parent.verticalCenter

        Button
          id: diffHardBtn
          !text: tr('Dificil')
          font: verdana-11px-rounded
          color: #ff5555
          width: 104
          height: 24
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter

      Label
        id: wavesTitle
        !text: tr('2. Criaturas da Onda e Custos:')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: diffButtonsRow.bottom
        anchors.left: parent.left
        margin-top: 8
        margin-left: 2
        text-auto-resize: true

      Panel
        id: wavesBox
        anchors.top: wavesTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 48
        image-source: /images/ui/containerslot
        image-border: 2
        padding: 4

        Label
          id: wavesSummaryLabel
          !text: tr('Onda: 3x Rotworm')
          font: verdana-11px-rounded
          color: #ffffff
          anchors.top: parent.top
          anchors.left: parent.left
          margin-left: 4
          margin-top: 2
          text-auto-resize: true

        Label
          id: suppliesLabel
          !text: tr('Suprimentos: ~10 gp / turno')
          font: verdana-11px-rounded
          color: #e0bb66
          anchors.bottom: parent.bottom
          anchors.left: parent.left
          margin-left: 4
          margin-bottom: 2
          text-auto-resize: true

      Label
        id: elementsTitle
        !text: tr('3. Fraquezas e Resistencias Elementais:')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: wavesBox.bottom
        anchors.left: parent.left
        margin-top: 8
        margin-left: 2
        text-auto-resize: true

      Panel
        id: elementsGrid
        anchors.top: elementsTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        margin-top: 4
        layout:
          type: grid
          cell-size: 78 30
          cell-spacing: 4
          flow: true

    Panel
      id: rightLootPanel
      anchors.top: detailCreatureHeader.bottom
      anchors.left: parent.horizontalCenter
      anchors.right: parent.right
      anchors.bottom: detailsTipBox.top
      margin-top: 6
      margin-left: 4
      margin-bottom: 6
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 6

      Panel
        id: lootHeader
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        height: 22

        Label
          id: lootTitle
          !text: tr('Loot Possivel:')
          font: verdana-11px-rounded
          color: #ffd700
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 2
          text-auto-resize: true

        Label
          id: keepColHeader
          !text: tr('PEGAR')
          font: verdana-11px-rounded
          color: #00ddff
          anchors.right: sellColHeader.left
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 14
          width: 44
          text-align: center

        Label
          id: sellColHeader
          !text: tr('VENDER')
          font: verdana-11px-rounded
          color: #ffd700
          anchors.right: parent.right
          anchors.verticalCenter: parent.verticalCenter
          margin-right: 10
          width: 44
          text-align: center

      VerticalScrollBar
        id: detailDropsScrollBar
        anchors.top: lootHeader.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 4
        step: 40
        pixels-scroll: true

      UIScrollArea
        id: detailDropsList
        anchors.top: lootHeader.bottom
        anchors.left: parent.left
        anchors.right: detailDropsScrollBar.left
        anchors.bottom: parent.bottom
        margin-top: 4
        margin-right: 4
        vertical-scrollbar: detailDropsScrollBar
        layout:
          type: verticalBox

    TipBox
      id: detailsTipBox
      anchors.bottom: reqPanel.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-bottom: 6
      height: 40

    Panel
      id: reqPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: startHuntButton.top
      margin-bottom: 8
      height: 44
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: reqSummaryLabel
        !text: tr('Requisitos de Sobrevivencia: Verificando...')
        font: verdana-11px-rounded
        color: #00ff88
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      Label
        id: reqDetailsLabel
        !text: tr('Level: OK | Ataque: OK | Defesa: OK | Banco: OK')
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 4
        margin-bottom: 2
        text-auto-resize: true

    Button
      id: startHuntButton
      !text: tr('INICIAR CACADA IDLE')
      font: verdana-11px-rounded
      color: #00ff88
      size: 240 32
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 4