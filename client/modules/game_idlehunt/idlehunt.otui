MainWindow
  id: idleHuntWindow
  !text: tr('IDLE HUNT - SISTEMA DE CAÇADAS')
  size: 720 620
  @onEscape: self:hide()

  -- =========================================================================
  -- TELA 1: DASHBOARD / MODO
  -- =========================================================================
  Panel
    id: dashboardView
    anchors.fill: parent
    visible: true

    -- Barra de Stamina IDLE
    Panel
      id: staminaPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 44
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 6

      Label
        id: staminaLabel
        !text: tr('Stamina IDLE: 24h 00m')
        font: verdana-11px-rounded
        color: #00ffcc
        anchors.top: parent.top
        anchors.left: parent.left
        text-auto-resize: true

      Label
        id: staminaInfo
        !text: tr('(Consumo 3x mais lento: 1h de Stamina = 3h reais)')
        font: verdana-11px-rounded
        color: #a0a0a0
        anchors.top: staminaLabel.top
        anchors.right: parent.right
        text-auto-resize: true

      ProgressBar
        id: staminaBar
        anchors.top: staminaLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 5
        height: 10
        background-color: #00cc88

    -- CARD 1: QUANDO ESTIVER LIVRE (IDLE MODE CARD)
    Panel
      id: idleModeCard
      anchors.top: staminaPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: dashboardBottomBar.top
      margin-top: 8
      margin-bottom: 8
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 16
      visible: true

      Label
        id: idleTitle
        !text: tr('PRONTO PARA INICIAR UMA CAÇADA IDLE')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 15
        text-auto-resize: true

      Label
        id: idleDesc
        !text: tr('Escolha uma das 21 hunts disponíveis divididas em Fácil, Médio e Difícil.\nConfigure sua intensidade de Pull, analise os elementos das criaturas e avance seu personagem de forma contínua e segura!')
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.top: idleTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 14
        margin-left: 20
        margin-right: 20
        text-align: center
        text-wrap: true

      Button
        id: openCatalogButton
        !text: tr('ORGANIZAR CAÇADA')
        font: verdana-11px-rounded
        color: #00ff88
        size: 240 34
        anchors.centerIn: parent
        tooltip: tr('Abrir o catálogo de hunts para escolher onde caçar')

      Label
        id: idleTipLabel
        !text: tr('Dica: Use o botão Quick Sell para vender instantaneamente os drops desbloqueados da sua backpack direto para a sua conta bancária.')
        font: verdana-11px-rounded
        color: #888888
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-bottom: 20
        text-align: center
        text-wrap: true

    -- CARD 2: QUANDO ESTIVER CAÇANDO (ACTIVE HUNT CARD)
    Panel
      id: activeHuntCard
      anchors.top: staminaPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: dashboardBottomBar.top
      margin-top: 8
      margin-bottom: 8
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 12
      visible: false

      Panel
        id: activeCreatureFrame
        size: 64 64
        image-source: /images/ui/containerslot
        image-border: 2
        anchors.top: parent.top
        anchors.left: parent.left
        margin-top: 4
        margin-left: 4

        UICreature
          id: activeCreature
          size: 58 58
          anchors.centerIn: parent
          phantom: true

      Label
        id: activeTitle
        !text: tr('Caçando: ...')
        font: verdana-11px-rounded
        color: #00ff88
        anchors.top: parent.top
        anchors.left: activeCreatureFrame.right
        margin-top: 4
        margin-left: 12
        text-auto-resize: true

      Label
        id: activePullLabel
        !text: tr('Intensidade: [Ousado]')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: activeTitle.bottom
        anchors.left: activeCreatureFrame.right
        margin-top: 4
        margin-left: 12
        text-auto-resize: true

      Panel
        id: activeStatsBox
        anchors.top: activeCreatureFrame.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: stopHuntButton.top
        margin-top: 10
        margin-bottom: 10
        image-source: /images/ui/containerslot
        image-border: 2
        padding: 8
        layout:
          type: verticalBox
          spacing: 6

        Label
          id: statXp
          !text: tr('Experiência Ganha: +0 XP')
          font: verdana-11px-rounded
          color: #00ff88
          text-auto-resize: true

        Label
          id: statGold
          !text: tr('Ouro / Loot Coletado: 0 gp')
          font: verdana-11px-rounded
          color: #ffd700
          text-auto-resize: true

        Label
          id: statSupplies
          !text: tr('Suprimentos Gastos: 0 gp')
          font: verdana-11px-rounded
          color: #ff9955
          text-auto-resize: true

        Label
          id: statRates
          !text: tr('Taxa Atual: 0 XP/h | 0 GP/h')
          font: verdana-11px-rounded
          color: #00ddff
          text-auto-resize: true

        Label
          id: statTime
          !text: tr('Tempo de Caçada: 00m 00s')
          font: verdana-11px-rounded
          color: #e0e0e0
          text-auto-resize: true

        Label
          id: statAutosell
          !text: tr('Próxima Auto-Venda em: 10m 00s')
          font: verdana-11px-rounded
          color: #a0a0a0
          text-auto-resize: true

      Button
        id: stopHuntButton
        !text: tr('ENCERRAR CAÇADA')
        font: verdana-11px-rounded
        color: #ff5555
        size: 200 28
        anchors.bottom: parent.bottom
        anchors.horizontalCenter: parent.horizontalCenter
        margin-bottom: 8

    -- Rodapé com Ações Rápidas
    Panel
      id: dashboardBottomBar
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 28
      layout:
        type: horizontalBox
        spacing: 6

      Button
        id: quickSellButton
        !text: tr('Quick Sell')
        font: verdana-11px-rounded
        width: 140
        color: #00ff88
        tooltip: tr('Vender imediatamente todos os itens da backpack marcados como [UNLOCKED]')

      Button
        id: teleportTempleButton
        !text: tr('Templo')
        font: verdana-11px-rounded
        width: 80
        tooltip: tr('Teleportar com segurança para o Templo')

      Button
        id: teleportHouseButton
        !text: tr('Casa')
        font: verdana-11px-rounded
        width: 80
        tooltip: tr('Teleportar para a sua casa')

      Panel
        id: spacer
        width: 280

      Button
        id: closeButton
        !text: tr('Fechar')
        font: verdana-11px-rounded
        width: 80
        @onClick: idleHuntController:toggle()

  -- =========================================================================
  -- TELA 2: CATÁLOGO DE HUNTS
  -- =========================================================================
  Panel
    id: catalogView
    anchors.fill: parent
    visible: false

    -- Topo do Catálogo
    Panel
      id: catalogTopBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      Button
        id: backToDashboardBtn
        !text: tr('< Voltar ao Painel')
        font: verdana-11px-rounded
        width: 130
        anchors.left: parent.left
        anchors.top: parent.top

      Label
        id: searchLabel
        !text: tr('Buscar:')
        font: verdana-11px-rounded
        anchors.verticalCenter: parent.verticalCenter
        anchors.right: searchEdit.left
        margin-right: 6
        text-auto-resize: true

      TextEdit
        id: searchEdit
        width: 200
        height: 24
        font: verdana-11px-rounded
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter

    -- Barra de Filtro de Dificuldade
    Panel
      id: catalogFilterPanel
      anchors.top: catalogTopBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 26
      layout:
        type: horizontalBox
        spacing: 6

    VerticalScrollBar
      id: huntListScrollBar
      anchors.top: catalogFilterPanel.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 6
      step: 40
      pixels-scroll: true

    UIScrollArea
      id: huntList
      anchors.top: catalogFilterPanel.bottom
      anchors.left: parent.left
      anchors.right: huntListScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 6
      margin-right: 4
      vertical-scrollbar: huntListScrollBar
      layout:
        type: verticalBox

  -- =========================================================================
  -- TELA 3: DETALHES DA HUNT, PULLS, ELEMENTOS E DROPS
  -- =========================================================================
  Panel
    id: detailsView
    anchors.fill: parent
    visible: false

    -- Topo
    Panel
      id: detailsTopBar
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      height: 28

      Button
        id: backToCatalogBtn
        !text: tr('< Voltar ao Catálogo')
        font: verdana-11px-rounded
        width: 140
        anchors.left: parent.left
        anchors.top: parent.top

      Label
        id: detailsTitle
        !text: tr('Configurar Caçada')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.verticalCenter: parent.verticalCenter
        anchors.left: backToCatalogBtn.right
        margin-left: 12
        text-auto-resize: true

    -- Cabeçalho da Criatura
    Panel
      id: detailCreatureHeader
      anchors.top: detailsTopBar.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 64
      image-source: /images/ui/containerslot
      image-border: 3
      padding: 4

      Panel
        id: detailCreatureFrame
        size: 54 54
        image-source: /images/ui/containerslot
        image-border: 2
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 2

        UICreature
          id: detailCreature
          size: 48 48
          anchors.centerIn: parent
          phantom: true

      Label
        id: detailHuntName
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: detailCreatureFrame.right
        margin-top: 2
        margin-left: 8
        text-auto-resize: true

      Label
        id: detailHuntDesc
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.top: detailHuntName.bottom
        anchors.left: detailCreatureFrame.right
        anchors.right: parent.right
        margin-top: 2
        margin-left: 8
        margin-right: 8
        text-wrap: true

      Label
        id: detailHuntInfo
        font: verdana-11px-rounded
        color: #e0bb66
        anchors.bottom: parent.bottom
        anchors.left: detailCreatureFrame.right
        margin-left: 8
        margin-bottom: 2
        text-auto-resize: true

      Label
        id: detailRecordLabel
        font: verdana-11px-rounded
        color: #00ddff
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-right: 8
        margin-bottom: 2
        text-auto-resize: true

    -- 1. SELEÇÃO DE PULLS
    Panel
      id: pullsPanel
      anchors.top: detailCreatureHeader.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 54
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: pullsTitle
        !text: tr('1. Intensidade do Pull (Quantidade de Monstros por Onda):')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      Button
        id: pullCautiousBtn
        !text: tr('Cauteloso (1 Mob)')
        font: verdana-11px-rounded
        width: 180
        height: 22
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 4
        margin-bottom: 2

      Button
        id: pullBoldBtn
        !text: tr('Ousado (2-3 Mobs)')
        font: verdana-11px-rounded
        width: 180
        height: 22
        anchors.bottom: parent.bottom
        anchors.left: pullCautiousBtn.right
        margin-left: 8
        margin-bottom: 2

      Button
        id: pullAggressiveBtn
        !text: tr('Agressivo (4-6 Mobs)')
        font: verdana-11px-rounded
        width: 180
        height: 22
        anchors.bottom: parent.bottom
        anchors.left: pullBoldBtn.right
        margin-left: 8
        margin-bottom: 2

    -- 2. FRAQUEZAS E RESISTÊNCIAS ELEMENTAIS
    Panel
      id: elementsPanel
      anchors.top: pullsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      height: 60
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: elementsTitle
        !text: tr('2. Fraquezas & Resistências Elementais das Criaturas:')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      Panel
        id: elementsRow
        anchors.top: elementsTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 36
        layout:
          type: horizontalBox
          spacing: 6

    -- 3. DROPS DA HUNT (PEGA vs VENDE)
    Panel
      id: dropsBoxPanel
      anchors.top: elementsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: reqPanel.top
      margin-top: 6
      margin-bottom: 6
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: dropsTitle
        !text: tr('3. Drops da Hunt (Itens com [LOCKED] ficam na mochila; [UNLOCKED] são vendidos no banco):')
        font: verdana-11px-rounded
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      VerticalScrollBar
        id: detailDropsScrollBar
        anchors.top: dropsTitle.bottom
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        margin-top: 4
        step: 40
        pixels-scroll: true

      UIScrollArea
        id: detailDropsList
        anchors.top: dropsTitle.bottom
        anchors.left: parent.left
        anchors.right: detailDropsScrollBar.left
        anchors.bottom: parent.bottom
        margin-top: 4
        margin-right: 4
        vertical-scrollbar: detailDropsScrollBar
        layout:
          type: verticalBox

    -- 4. PAINEL DE REQUISITOS DE SOBREVIVÊNCIA
    Panel
      id: reqPanel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: startHuntButton.top
      margin-bottom: 8
      height: 48
      image-source: /images/ui/containerslot
      image-border: 2
      padding: 4

      Label
        id: reqSummaryLabel
        !text: tr('Requisitos de Sobrevivência: Verificando...')
        font: verdana-11px-rounded
        color: #00ff88
        anchors.top: parent.top
        anchors.left: parent.left
        margin-left: 4
        text-auto-resize: true

      Label
        id: reqDetailsLabel
        !text: tr('Level: OK | Ataque: OK | Defesa: OK | Banco: OK | Poções: Health/Mana')
        font: verdana-11px-rounded
        color: #c0c0c0
        anchors.bottom: parent.bottom
        anchors.left: parent.left
        margin-left: 4
        margin-bottom: 2
        text-auto-resize: true

    -- BOTÃO DE INICIAR CAÇADA
    Button
      id: startHuntButton
      !text: tr('INICIAR CAÇADA IDLE')
      font: verdana-11px-rounded
      color: #00ff88
      size: 240 30
      anchors.bottom: parent.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-bottom: 4