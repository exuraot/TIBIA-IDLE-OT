MainWindow
  id: requirementsWindow
  !text: tr('Hunt Requirements Checker')
  size: 460 380
  @onEscape: self:hide()

  Panel
    id: statusBanner
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 38
    image-source: /images/ui/containerslot
    image-border: 3
    padding: 4

    Label
      id: statusText
      !text: tr('Status: Calculating...')
      font: verdana-11px-rounded
      anchors.centerIn: parent
      text-auto-resize: true

  Panel
    id: checklistPanel
    anchors.top: statusBanner.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: closeReqButton.top
    margin-top: 8
    margin-bottom: 8
    image-source: /images/ui/containerslot
    image-border: 3
    padding: 8
    layout:
      type: verticalBox
      spacing: 8

    Label
      id: lvlLabel
      font: verdana-11px-rounded
      text-auto-resize: true

    Label
      id: atkLabel
      font: verdana-11px-rounded
      text-auto-resize: true

    Label
      id: defLabel
      font: verdana-11px-rounded
      text-auto-resize: true

    Label
      id: bankLabel
      font: verdana-11px-rounded
      text-auto-resize: true

    Label
      id: potionsLabel
      font: verdana-11px-rounded
      color: #ffd700
      text-auto-resize: true

    Label
      id: ruleNotice
      font: verdana-11px-rounded
      color: #d0d0d0
      text-wrap: true
      margin-top: 10
      !text: tr('Rule: If you meet 100% of recommended requirements, automatic rescue activates at 10% HP. Otherwise, you face real risk of death!')

  Button
    id: startFromReqButton
    !text: tr('Start This Hunt')
    font: verdana-11px-rounded
    width: 150
    anchors.left: parent.left
    anchors.bottom: parent.bottom

  Button
    id: closeReqButton
    !text: tr('Close')
    font: verdana-11px-rounded
    width: 90
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    @onClick: self:getParent():hide()
