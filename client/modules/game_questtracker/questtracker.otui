GuideCategoryButton < UIButton
  height: 26
  text-align: left
  text-offset: 26 0
  font: verdana-11px-rounded
  color: #cccccc
  background-color: #1a222d
  border-width: 1
  border-color: #2c3848
  margin-bottom: 4
  $hover:
    background-color: #243040
    color: #ffffff
    border-color: #3d4f66
  $pressed:
    background-color: #151c25
  $checked:
    background-color: #2b3b50
    color: #ffd700
    border-color: #e5a720

WalkthroughItemSlot < UIItem
  size: 34 34
  image-source: /images/ui/2pixel_up_frame_borderimage
  image-border: 10
  padding: 1
  virtual: true

  Label
    id: countLabel
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 2
    margin-bottom: -1
    font: verdana-11px-rounded
    color: #BFBFBF
    text-auto-resize: true
    visible: false

GuideCard < Panel
  height: 86
  image-source: /images/ui/panel_flat
  image-border: 10
  margin-bottom: 6
  padding: 6
  $hover:
    border-color: #3d4f66

  Panel
    id: previewBox
    size: 54 54
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    image-source: /images/ui/outfits/minipanel
    image-border: 20
    padding: 3

    UICreature
      id: creaturePreview
      size: 48 48
      anchors.centerIn: parent
      phantom: true
      visible: false

    UIItem
      id: itemPreview
      size: 36 36
      anchors.centerIn: parent
      virtual: true
      visible: false

  Label
    id: name
    anchors.left: previewBox.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: 2
    font: verdana-11px-rounded
    color: #ffd700
    text-auto-resize: true

  UIWidget
    id: categoryBadge
    size: 60 16
    anchors.left: name.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 1
    font: verdana-9px-bold
    text-align: center
    color: #C0C0C0
    background-color: #222b38
    border-width: 1
    border-color: #3b5066

  Label
    id: details
    anchors.left: previewBox.right
    anchors.top: name.bottom
    anchors.right: actionButtons.left
    margin-left: 10
    margin-top: 4
    margin-right: 10
    font: verdana-11px-rounded
    color: #aaaaaa
    text-wrap: true

  Label
    id: npcInfo
    anchors.left: previewBox.right
    anchors.right: actionButtons.left
    anchors.bottom: parent.bottom
    margin-left: 10
    margin-right: 8
    margin-bottom: 2
    height: 16
    font: verdana-11px-rounded
    color: #00ffff
    text-auto-resize: false

  Panel
    id: actionButtons
    width: 195
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 24

    Button
      id: btnWalkthrough
      width: 92
      height: 22
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 4
      font: small-9px
      text: Walkthrough
      text-offset: 0 -1
      color: #ffd700

    Button
      id: btnMarkMap
      width: 92
      height: 22
      anchors.left: prev.right
      anchors.top: parent.top
      margin-left: 6
      margin-top: 4
      font: small-9px
      text: Mark on Map
      text-offset: 0 -1
      color: #00e0e0

    Button
      id: btnPin
      width: 92
      height: 22
      anchors.left: parent.left
      anchors.top: prev.bottom
      margin-top: 6
      font: small-9px
      text: Pin to HUD
      text-offset: 0 -1

    Button
      id: btnQuickDetails
      width: 92
      height: 22
      anchors.left: prev.right
      anchors.top: prev.top
      margin-left: 6
      font: small-9px
      text: Details
      text-offset: 0 -1

GuideExplorerWindow < MainWindow
  id: guideExplorerWindow
  !text: tr('Quest & Guide Explorer')
  size: 680 520
  anchors.centerIn: parent
  @onEscape: self:hide()

  Panel
    id: searchPanel
    height: 28
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top

    Label
      id: searchLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      font: verdana-11px-rounded
      color: #C0C0C0
      text: Search:
      margin-right: 6

    TextEdit
      id: searchEdit
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: verdana-11px-monochrome
      color: #ffffff
      placeholder: Type quest, addon, mount, city or NPC name...
      placeholder-color: #6E706F

  Panel
    id: sidebar
    width: 140
    anchors.left: parent.left
    anchors.top: searchPanel.bottom
    anchors.bottom: footerPanel.top
    margin-top: 8
    margin-bottom: 8
    image-source: /images/ui/panel_flat
    image-border: 10
    padding: 6

    Label
      id: sidebarTitle
      anchors.top: parent.top
      anchors.horizontalCenter: parent.horizontalCenter
      font: small-9px
      color: #ffd700
      text: CATEGORIES
      margin-top: 2

    GuideCategoryButton
      id: catAll
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: sidebarTitle.bottom
      margin-top: 8
      text: All Guides
      checked: true

    GuideCategoryButton
      id: catQuest
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Main Quests

    GuideCategoryButton
      id: catAddon
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Outfits & Addons

    GuideCategoryButton
      id: catMount
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Mounts

    GuideCategoryButton
      id: catAccess
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Access & Gates

  VerticalScrollBar
    id: explorerScrollBar
    anchors.top: searchPanel.bottom
    anchors.bottom: footerPanel.top
    anchors.right: parent.right
    margin-top: 8
    margin-bottom: 8
    step: 40
    pixels-scroll: true

  ScrollablePanel
    id: cardsContainer
    anchors.left: sidebar.right
    anchors.right: explorerScrollBar.left
    anchors.top: searchPanel.bottom
    anchors.bottom: footerPanel.top
    margin-left: 8
    margin-right: 4
    margin-top: 8
    margin-bottom: 8
    vertical-scrollbar: explorerScrollBar
    layout:
      type: verticalBox

  Panel
    id: footerPanel
    height: 26
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Label
      id: countLabel
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      font: verdana-11px-rounded
      color: #999999
      text: Showing all guides.

    Button
      id: btnClose
      width: 74
      height: 22
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      font: small-9px
      text: Close
      text-offset: 0 -1
      @onClick: self:getParent():getParent():hide()

QuestWalkthroughWindow < MainWindow
  id: questWalkthroughWindow
  !text: tr('Quest Walkthrough & In-Game Wiki')
  size: 470 540
  anchors.centerIn: parent
  @onEscape: self:hide()

  Panel
    id: headerBox
    height: 60
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    image-source: /images/ui/panel_flat
    image-border: 10
    padding: 5

    Panel
      id: detailAvatarBox
      size: 48 48
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      image-source: /images/ui/outfits/minipanel
      image-border: 20
      padding: 2

      UICreature
        id: detailCreature
        size: 42 42
        anchors.centerIn: parent
        phantom: true
        visible: false

      UIItem
        id: detailItem
        size: 32 32
        anchors.centerIn: parent
        virtual: true
        visible: false

    Label
      id: detailTitle
      font: verdana-11px-rounded
      color: #ffd700
      anchors.left: detailAvatarBox.right
      anchors.top: parent.top
      margin-left: 10
      margin-top: 4
      text-auto-resize: true

    Label
      id: detailSubtitle
      font: small-9px
      color: #00ffff
      anchors.left: detailAvatarBox.right
      anchors.top: detailTitle.bottom
      margin-left: 10
      margin-top: 2
      text-auto-resize: true

    Button
      id: btnHeaderMarkMap
      width: 96
      height: 22
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 4
      font: small-9px
      text: Mark on Map
      text-offset: 0 -1
      color: #00e0e0

  UIWidget
    id: separatorTop
    height: 2
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: headerBox.bottom
    margin-top: 6
    image-source: /images/ui/separator_horizontal

  Panel
    id: stepNavBar
    height: 24
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: separatorTop.bottom
    margin-top: 6

    Button
      id: prevStepBtn
      size: 20 20
      anchors.right: stepProgressLabel.left
      anchors.verticalCenter: parent.verticalCenter
      margin-right: 6
      icon-source: /game_cyclopedia/images/icon-left-arrow
      $disabled:
        icon-source: /game_cyclopedia/images/icon-left-arrow-disabled
      $pressed:
        icon-source: /game_cyclopedia/images/icon-left-arrow-disabled

    UIWidget
      id: stepProgressLabel
      size: 90 20
      anchors.horizontalCenter: parent.horizontalCenter
      anchors.verticalCenter: parent.verticalCenter
      text-align: center
      font: verdana-11px-rounded
      color: #C2C2C2
      !text: tr('1 / 1')

    Button
      id: nextStepBtn
      size: 20 20
      anchors.left: stepProgressLabel.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      icon-source: /game_cyclopedia/images/icon-right-arrow
      $disabled:
        icon-source: /game_cyclopedia/images/icon-right-arrow-disabled
      $pressed:
        icon-source: /game_cyclopedia/images/icon-right-arrow

  Label
    id: stepTitleLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: stepNavBar.bottom
    margin-top: 4
    font: verdana-11px-rounded
    color: #ffffff
    text-align: center
    text-auto-resize: false
    height: 18

  VerticalScrollBar
    id: walkthroughScrollBar
    anchors.top: stepTitleLabel.bottom
    anchors.bottom: rewardsBox.top
    anchors.right: parent.right
    margin-top: 6
    margin-bottom: 6
    step: 25
    pixels-scroll: true

  ScrollablePanel
    id: stepContentPanel
    anchors.left: parent.left
    anchors.right: walkthroughScrollBar.left
    anchors.top: stepTitleLabel.bottom
    anchors.bottom: rewardsBox.top
    margin-top: 6
    margin-bottom: 6
    margin-right: 4
    vertical-scrollbar: walkthroughScrollBar
    image-source: /images/ui/panel_flat
    image-border: 10
    padding: 8
    layout:
      type: verticalBox

    Panel
      id: stepTargetBox
      height: 52
      image-source: /images/ui/panel_flat
      image-border: 6
      padding: 4
      margin-bottom: 6

      Panel
        id: stepCreatureBox
        size: 42 42
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        image-source: /images/ui/outfits/minipanel
        image-border: 15
        padding: 2

        UICreature
          id: stepCreature
          size: 38 38
          anchors.centerIn: parent
          phantom: true
          visible: false

        UIItem
          id: stepItem
          size: 32 32
          anchors.centerIn: parent
          virtual: true
          visible: false

      Label
        id: stepNpcLabel
        font: verdana-11px-rounded
        color: #00ffff
        anchors.left: stepCreatureBox.right
        anchors.top: parent.top
        margin-left: 8
        margin-top: 2
        text-auto-resize: true

      Label
        id: stepLocationLabel
        font: small-9px
        color: #C0C0C0
        anchors.left: stepCreatureBox.right
        anchors.top: stepNpcLabel.bottom
        margin-left: 8
        margin-top: 2
        text-auto-resize: true

      Button
        id: btnStepMarkMap
        width: 90
        height: 22
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 4
        font: small-9px
        text: Mark on Map
        text-offset: 0 -1
        color: #00e0e0

    Label
      id: objHeader
      font: small-9px
      color: #ffd700
      text: OBJECTIVE & INSTRUCTIONS:
      margin-bottom: 2

    Label
      id: stepInstructionText
      font: verdana-11px-rounded
      color: #C0C0C0
      text-wrap: true
      text-auto-resize: true
      margin-bottom: 8

    Label
      id: dialogueHeader
      font: small-9px
      color: #00ffff
      text: NPC DIALOGUE TRANSCRIPT:
      margin-bottom: 2
      visible: false

    Label
      id: stepDialogueText
      font: verdana-11px-rounded
      color: #00e0e0
      background-color: #0e141c
      border-width: 1
      border-color: #253342
      padding: 6
      text-wrap: true
      text-auto-resize: true
      margin-bottom: 6
      visible: false

  Panel
    id: rewardsBox
    height: 72
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: footerPanel.top
    margin-bottom: 6
    image-source: /images/ui/panel_flat
    image-border: 10
    padding: 6

    Label
      id: rewardsTitle
      font: small-9px
      color: #ffd700
      text: REWARDS & UNLOCKS:
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 2
      margin-top: 1
      text-auto-resize: true

    Panel
      id: rewardOutfitBox
      size: 40 40
      anchors.left: parent.left
      anchors.bottom: parent.bottom
      margin-left: 2
      margin-bottom: 2
      image-source: /images/ui/outfits/minipanel
      image-border: 15
      padding: 2
      visible: false

      UICreature
        id: rewardCreature
        size: 36 36
        anchors.centerIn: parent
        phantom: true

    Panel
      id: rewardItemsContainer
      anchors.left: rewardOutfitBox.right
      anchors.top: rewardsTitle.bottom
      anchors.bottom: parent.bottom
      margin-left: 6
      margin-top: 2
      margin-bottom: 2
      width: 150
      layout:
        type: horizontalBox
        spacing: 4

    Label
      id: rewardsSummaryText
      font: verdana-11px-rounded
      color: #88ff88
      anchors.left: rewardItemsContainer.right
      anchors.right: parent.right
      anchors.top: rewardsTitle.bottom
      anchors.bottom: parent.bottom
      margin-left: 8
      margin-top: 4
      margin-bottom: 2
      text-wrap: true
      text-auto-resize: false

  Panel
    id: footerPanel
    height: 26
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Button
      id: btnPrevStepBottom
      width: 90
      height: 22
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      font: small-9px
      text: < Prev Step
      text-offset: 0 -1

    Button
      id: btnNextStepBottom
      width: 90
      height: 22
      anchors.left: prev.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 6
      font: small-9px
      text: Next Step >
      text-offset: 0 -1

    Button
      id: btnClose
      width: 74
      height: 22
      anchors.right: parent.right
      anchors.verticalCenter: parent.verticalCenter
      font: small-9px
      text: Close
      text-offset: 0 -1
      @onClick: self:getParent():getParent():hide()

QuestTrackerMiniWindow < MiniWindow
  id: questTrackerMiniWindow
  !text: tr('Quest Tracker')
  height: 180
  icon: /images/topbuttons/icon-questtracker-widget
  @onOpen: modules.game_questtracker.onMiniWindowOpen()
  @onClose: modules.game_questtracker.onMiniWindowClose()

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/topbuttons/icon-questtracker-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Quest Tracker')
    color: #9d9d9dff

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 4
    margin-right: 4
    margin-top: 2
    margin-bottom: 4
    layout: verticalBox

    Panel
      id: emptyBox
      height: 100
      visible: true
      layout: verticalBox

      Label
        text: No Active Guide.
        text-align: center
        font: verdana-11px-rounded
        color: #888888
        margin-top: 15

      Label
        text: Open explorer to track Quests, Addons, and Mounts.
        text-align: center
        text-wrap: true
        font: verdana-11px-rounded
        color: #667788
        margin-top: 4

      Button
        id: btnOpenExplorerEmpty
        text: Browse Guides
        width: 120
        height: 22
        anchors.horizontalCenter: parent.horizontalCenter
        margin-top: 10
        font: small-9px
        text-offset: 0 -1
        @onClick: modules.game_questtracker.showExplorer()

    Panel
      id: activeBox
      height: 140
      visible: false

      Label
        id: trackedTitle
        font: verdana-11px-rounded
        color: #ffd700
        text-wrap: true
        margin-top: 2
        margin-left: 2
        margin-right: 2

      Label
        id: trackedCity
        font: small-9px
        color: #888888
        text-wrap: true
        margin-top: 1
        margin-left: 2
        margin-right: 2

      Label
        id: trackedTarget
        font: verdana-11px-rounded
        color: #00ffff
        text-wrap: true
        margin-top: 2
        margin-left: 2
        margin-right: 2

      Label
        id: trackedStep
        font: verdana-11px-rounded
        color: #e0e0e0
        text-wrap: true
        margin-top: 2
        margin-left: 2
        margin-right: 2

      Panel
        id: miniControls
        height: 24
        margin-top: 6
        anchors.left: parent.left
        anchors.right: parent.right

        Button
          id: btnMiniMap
          text: Mark Map
          width: 80
          height: 22
          anchors.left: parent.left
          anchors.verticalCenter: parent.verticalCenter
          font: small-9px
          text-offset: 0 -1
          color: #00e0e0

        Button
          id: btnMiniDetails
          text: Walkthrough
          width: 80
          height: 22
          anchors.left: prev.right
          anchors.verticalCenter: parent.verticalCenter
          margin-left: 4
          font: small-9px
          text-offset: 0 -1
          color: #ffd700