GuideCategoryButton < UIButton
  height: 28
  text-align: left
  text-offset: 28 0
  font: verdana-11px-rounded
  color: #cccccc
  background-color: #1a222d
  border-width: 1
  border-color: #2c3848
  margin-bottom: 4
  $hover:
    background-color: #243040
    color: #ffffff
    border-color: #3d4f66
  $pressed:
    background-color: #151c25
  $checked:
    background-color: #2b3b50
    color: #ffd700
    border-color: #e5a720

GuideCard < Panel
  height: 86
  background-color: #161c24
  border-width: 1
  border-color: #252f3d
  margin-bottom: 6
  padding: 6
  $hover:
    border-color: #3d4f66
    background-color: #1a222c

  Panel
    id: previewBox
    size: 56 60
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 2
    background-color: #11151b
    border-width: 1
    border-color: #252f3d

    UICreature
      id: creaturePreview
      size: 48 48
      anchors.centerIn: parent
      phantom: true
      visible: false

    UIItem
      id: itemPreview
      size: 38 38
      anchors.centerIn: parent
      virtual: true
      visible: false

  Label
    id: name
    anchors.left: previewBox.right
    anchors.top: parent.top
    margin-left: 10
    margin-top: 2
    font: verdana-11px-rounded
    color: #ffd700
    text-auto-resize: true

  UIWidget
    id: categoryBadge
    size: 58 16
    anchors.left: name.right
    anchors.top: parent.top
    margin-left: 8
    margin-top: 1
    font: verdana-9px-bold
    text-align: center
    color: #ffffff
    background-color: #2b3a4a
    border-width: 1
    border-color: #3b5066

  Label
    id: details
    anchors.left: previewBox.right
    anchors.top: name.bottom
    anchors.right: actionButtons.left
    margin-left: 10
    margin-top: 4
    margin-right: 10
    font: verdana-11px-rounded
    color: #aaaaaa
    text-wrap: true

  Label
    id: npcInfo
    anchors.left: previewBox.right
    anchors.right: actionButtons.left
    anchors.bottom: parent.bottom
    margin-left: 10
    margin-right: 8
    margin-bottom: 2
    height: 16
    font: verdana-11px-rounded
    color: #00ffcc
    text-auto-resize: false

  Panel
    id: actionButtons
    width: 185
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 22

    Button
      id: btnTrack
      width: 90
      height: 24
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 4
      font: verdana-11px-rounded
      text: Track Map
      color: #ffd700
      border-color: #ccaa00
      $hover:
        color: #ffffff
        border-color: #ffd700

    Button
      id: btnGps
      width: 85
      height: 24
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 4
      font: verdana-11px-rounded
      text: Start GPS
      color: #00ffff
      border-color: #00aaaa
      $hover:
        color: #ffffff
        border-color: #00ffff

    Button
      id: btnDetails
      width: 181
      height: 22
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-bottom: 4
      font: verdana-11px-rounded
      text: Quest Details
      color: #e0e0e0
      $hover:
        color: #ffffff

GuideExplorerWindow < MainWindow
  id: guideExplorerWindow
  !text: tr('Quests, Addons, Mounts & Access Explorer')
  size: 850 590
  anchors.centerIn: parent
  @onEscape: self:hide()

  Panel
    id: sidebar
    width: 185
    anchors.left: parent.left
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-right: 8

    Label
      id: sidebarTitle
      text: CATEGORIES
      font: verdana-11px-rounded
      color: #ffd700
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 4
      margin-left: 4

    GuideCategoryButton
      id: catAll
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: sidebarTitle.bottom
      margin-top: 8
      text: All Guides
      checked: true

    GuideCategoryButton
      id: catQuest
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Main Quests

    GuideCategoryButton
      id: catAddon
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Addons & Outfits

    GuideCategoryButton
      id: catMount
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Mounts

    GuideCategoryButton
      id: catAccess
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: prev.bottom
      text: Access & Gates

    Panel
      id: trackerStatusBox
      height: 124
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      background-color: #12171e
      border-width: 1
      border-color: #2b3a4a
      padding: 6

      Label
        text: ACTIVE GUIDE
        font: verdana-9px-bold
        color: #ffd700
        anchors.top: parent.top
        anchors.left: parent.left

      Label
        id: activeGuideName
        text: None Selected
        font: verdana-11px-rounded
        color: #ffffff
        anchors.top: prev.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        text-auto-resize: true

      Label
        id: activeGpsStatus
        text: GPS: Disabled
        font: verdana-11px-rounded
        color: #888888
        anchors.top: prev.bottom
        anchors.left: parent.left
        margin-top: 4

      Button
        id: btnStopAllGps
        text: Clear Active Guide
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.bottom: parent.bottom
        height: 22
        font: verdana-11px-rounded
        color: #ff5555
        border-color: #aa3333

  Panel
    id: mainContent
    anchors.left: sidebar.right
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: parent.bottom
    margin-left: 8

    TextEdit
      id: searchInput
      anchors.left: parent.left
      anchors.right: btnClose.left
      anchors.top: parent.top
      margin-right: 8
      height: 26
      font: verdana-11px-rounded
      placeholder: Search quest, NPC, city, addon or mount...
      placeholder-color: #667788

    Button
      id: btnClose
      width: 70
      height: 26
      anchors.right: parent.right
      anchors.top: parent.top
      text: Close
      @onClick: self:getParent():getParent():hide()

    VerticalScrollBar
      id: guideScrollBar
      anchors.top: searchInput.bottom
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-top: 8
      step: 40
      pixels-scroll: true

    ScrollablePanel
      id: guideList
      anchors.left: parent.left
      anchors.right: guideScrollBar.left
      anchors.top: searchInput.bottom
      anchors.bottom: parent.bottom
      margin-top: 8
      margin-right: 4
      vertical-scrollbar: guideScrollBar
      layout:
        type: verticalBox

QuestDetailsWindow < MainWindow
  id: questDetailsWindow
  !text: tr('Quest Guide & Dialogue Walkthrough')
  size: 600 520
  anchors.centerIn: parent
  @onEscape: self:hide()

  Panel
    id: headerBox
    height: 68
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    background-color: #161c24
    border-width: 1
    border-color: #2b3848
    padding: 6

    Panel
      id: detailAvatarBox
      size: 54 54
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      background-color: #10141a
      border-width: 1
      border-color: #222b38

      UICreature
        id: detailCreature
        size: 48 48
        anchors.centerIn: parent
        phantom: true
        visible: false

      UIItem
        id: detailItem
        size: 38 38
        anchors.centerIn: parent
        virtual: true
        visible: false

    Label
      id: detailTitle
      font: verdana-11px-rounded
      color: #ffd700
      anchors.left: detailAvatarBox.right
      anchors.top: parent.top
      margin-left: 12
      margin-top: 4
      text-auto-resize: true

    UIWidget
      id: detailBadge
      size: 60 16
      anchors.left: detailTitle.right
      anchors.top: parent.top
      margin-left: 8
      margin-top: 4
      font: verdana-9px-bold
      text-align: center
      color: #ffffff
      background-color: #2b3a4a
      border-width: 1
      border-color: #3b5066

    Label
      id: detailNpcInfo
      font: verdana-11px-rounded
      color: #00ffcc
      anchors.left: detailAvatarBox.right
      anchors.top: detailTitle.bottom
      margin-left: 12
      margin-top: 4
      text-auto-resize: true

    Label
      id: detailLevelInfo
      font: verdana-11px-rounded
      color: #e0e0e0
      anchors.left: detailAvatarBox.right
      anchors.bottom: parent.bottom
      margin-left: 12
      margin-bottom: 4
      text-auto-resize: true

  Panel
    id: footerPanel
    height: 32
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom

    Button
      id: btnDetailTrack
      width: 130
      height: 26
      anchors.left: parent.left
      anchors.top: parent.top
      font: verdana-11px-rounded
      text: Track on Map
      color: #ffd700
      border-color: #ccaa00

    Button
      id: btnDetailGps
      width: 120
      height: 26
      anchors.left: prev.right
      anchors.top: parent.top
      margin-left: 8
      font: verdana-11px-rounded
      text: Start GPS
      color: #00ffff
      border-color: #00aaaa

    Button
      id: btnDetailClose
      width: 80
      height: 26
      anchors.right: parent.right
      anchors.top: parent.top
      font: verdana-11px-rounded
      text: Close
      @onClick: self:getParent():getParent():hide()

  VerticalScrollBar
    id: detailScrollBar
    anchors.top: headerBox.bottom
    anchors.bottom: footerPanel.top
    anchors.right: parent.right
    margin-top: 8
    margin-bottom: 8
    step: 40
    pixels-scroll: true

  ScrollablePanel
    id: detailsContent
    anchors.left: parent.left
    anchors.right: detailScrollBar.left
    anchors.top: headerBox.bottom
    anchors.bottom: footerPanel.top
    margin-top: 8
    margin-bottom: 8
    margin-right: 4
    vertical-scrollbar: detailScrollBar
    layout:
      type: verticalBox

    Label
      id: loreTitle
      text: STORY & OVERVIEW
      font: verdana-11px-rounded
      color: #ffd700
      margin-top: 4

    Label
      id: loreText
      font: verdana-11px-rounded
      color: #cccccc
      margin-top: 4
      text-wrap: true
      text-auto-resize: true

    Label
      id: dialogueTitle
      text: DIALOGUE & WALKTHROUGH
      font: verdana-11px-rounded
      color: #ffd700
      margin-top: 10

    Label
      id: dialogueText
      font: verdana-11px-rounded
      color: #00ffcc
      background-color: #0f141c
      border-width: 1
      border-color: #253242
      padding: 8
      margin-top: 4
      text-wrap: true
      text-auto-resize: true

    Label
      id: rewardsTitle
      text: REWARDS & UNLOCKS
      font: verdana-11px-rounded
      color: #ffd700
      margin-top: 10

    Label
      id: rewardsText
      font: verdana-11px-rounded
      color: #88ff88
      margin-top: 4
      text-wrap: true
      text-auto-resize: true

GpsOverlay < Panel
  anchors.fill: parent
  background-color: alpha
  phantom: true
  focusable: false
  visible: false

GpsDot < UIWidget
  size: 24 24
  image-source: /modules/game_questtracker/images/gps_dot
  phantom: true
  focusable: false
  visible: false

GpsBeacon < UIWidget
  size: 38 38
  image-source: /modules/game_questtracker/images/gps_beacon
  phantom: true
  focusable: false
  visible: false

  Label
    id: label
    anchors.bottom: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-bottom: 4
    font: verdana-11px-rounded
    color: #ffd700
    text-auto-resize: true

GpsMinimapMarker < UIWidget
  size: 20 20
  image-source: /modules/game_questtracker/images/gps_minimap_pointer
  phantom: false
  focusable: false
  visible: false

QuestTrackerMiniWindow < MiniWindow
  id: questTrackerMiniWindow
  !text: tr('Quest Tracker')
  height: 190
  icon: /images/topbuttons/icon-questtracker-widget
  @onOpen: modules.game_questtracker.onMiniWindowOpen()
  @onClose: modules.game_questtracker.onMiniWindowClose()

  UIWidget
    id: miniwindowIcon
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    margin-top: 2
    margin-left: 4
    size: 12 12
    image-source: /images/topbuttons/icon-questtracker-widget
    image-smooth: false

  Label
    id: miniwindowTitle
    anchors.top: miniwindowHeader.top
    anchors.left: miniwindowHeader.left
    anchors.right: miniwindowHeader.right
    margin-top: 2
    margin-left: 20
    margin-right: 50
    font: verdana-11px-monochrome
    height: 13
    !text: tr('Quest Tracker')
    color: #9d9d9dff

  MiniWindowContents
    id: contentsPanel
    anchors.top: miniwindowTopBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-left: 4
    margin-right: 4
    margin-top: 2
    margin-bottom: 4
    layout: verticalBox

    Panel
      id: emptyBox
      height: 110
      visible: true
      layout: verticalBox

      Label
        text: No Active Guide.
        text-align: center
        font: verdana-11px-rounded
        color: #888888
        margin-top: 15

      Label
        text: Open explorer to track Quests, Addons, and Mounts.
        text-align: center
        text-wrap: true
        font: verdana-11px-rounded
        color: #667788
        margin-top: 4
        margin-left: 6
        margin-right: 6

      Button
        id: btnOpenExplorer
        height: 24
        margin-top: 10
        margin-left: 10
        margin-right: 10
        font: verdana-11px-rounded
        text: Open Quest Explorer
        color: #ffd700
        border-color: #ccaa00
        @onClick: modules.game_questtracker.showExplorer()

    Panel
      id: activeBox
      height: 155
      visible: false
      layout:
        type: verticalBox
        fit-children: true

      Label
        id: trackedTitle
        font: verdana-11px-rounded
        color: #ffd700
        text-wrap: true
        margin-top: 1
        margin-left: 2
        margin-right: 2

      Label
        id: trackedTarget
        font: verdana-11px-rounded
        color: #00ffcc
        text-wrap: true
        margin-top: 2
        margin-left: 2
        margin-right: 2

      Label
        id: trackedStep
        font: verdana-11px-rounded
        color: #e0e0e0
        text-wrap: true
        margin-top: 2
        margin-left: 2
        margin-right: 2

      Label
        id: trackedHint
        font: verdana-11px-rounded
        color: #ffd966
        text-wrap: true
        margin-top: 2
        margin-left: 2
        margin-right: 2

      Label
        id: trackedDistance
        font: verdana-11px-rounded
        color: #00ffff
        text-wrap: true
        margin-top: 3
        margin-left: 2
        margin-right: 2

      Panel
        id: miniControls
        height: 24
        margin-top: 6
        anchors.left: parent.left
        anchors.right: parent.right

        Button
          id: btnToggleGps
          height: 22
          anchors.left: parent.left
          anchors.right: btnMiniDetails.left
          margin-right: 4
          font: verdana-11px-rounded
          text: GPS: ON
          color: #00ff88
          border-color: #00aa55

        Button
          id: btnMiniDetails
          width: 46
          height: 22
          anchors.right: btnUntrack.left
          margin-right: 4
          font: verdana-11px-rounded
          text: Info
          color: #ffd700
          border-color: #ccaa00
          @onClick: modules.game_questtracker.showDetailsForActive()

        Button
          id: btnUntrack
          width: 20
          height: 22
          anchors.right: parent.right
          font: verdana-11px-rounded
          text: X
          color: #ff5555
          border-color: #aa3333
          tooltip: Untrack quest

GpsTopBanner < Panel
  id: gpsTopBanner
  size: 460 34
  anchors.horizontalCenter: parent.horizontalCenter
  anchors.top: parent.top
  margin-top: 38
  background-color: #0b0f16f0
  border-width: 1
  border-color: #00ffff
  phantom: false
  focusable: false
  visible: false

  UIWidget
    id: gpsIcon
    size: 18 18
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    image-source: /images/topbuttons/minimap
    phantom: true

  Label
    id: targetLabel
    anchors.left: gpsIcon.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-rounded
    color: #00ffff
    text: Navigating to Target...
    text-auto-resize: true

  Label
    id: distanceLabel
    anchors.left: targetLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    font: verdana-11px-rounded
    color: #ffd700
    text: 0m [NE]
    text-auto-resize: true

  Label
    id: floorLabel
    anchors.left: distanceLabel.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    font: verdana-11px-rounded
    color: #00ff88
    text: [Surface]
    text-auto-resize: true

  Button
    id: btnStopGps
    width: 24
    height: 22
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    font: verdana-11px-rounded
    text: X
    color: #ff5555
    border-color: #aa3333
    $hover:
      color: #ffffff
      border-color: #ff5555
    @onClick: modules.game_questtracker.questTracker.stopGps()
